---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/828-favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Client Trends</title>
		<script is:inline src="/vendor/htmx.min.js"></script>
		<script is:inline src="/vendor/alpine.min.js" defer></script>
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink">
		<slot />

		<div
			id="cx-paste-preview"
			class="fixed z-50 hidden w-[440px] max-w-[calc(100vw-16px)] rounded-lg border border-card-border bg-surface p-3 shadow-lg"
			role="dialog"
			aria-label="Paste from spreadsheet"
		>
		</div>
		<div
			id="cx-toast"
			class="fixed bottom-4 right-4 z-50 hidden max-w-sm rounded-lg border border-needs-attention-line bg-needs-attention-tint px-4 py-2 text-[13px] text-needs-attention-text shadow-lg"
			role="alert"
		>
		</div>
		<script is:inline>
			(function () {
				// htmx never swaps a 4xx/5xx response body in by default (responseHandling:
				// [45].. -> swap:false) — but our routes deliberately render a full HTML
				// fragment with a specific inline message on 400 (validation failure), meant
				// to replace the section in place. Without this override that fragment was
				// silently discarded and only the generic toast below ever showed, even for
				// the user's own input mistakes. True 5xx/network failures still fall
				// through to the toast, since there's no useful fragment to show for those.
				htmx.config.responseHandling.unshift({ code: "400", swap: true });

				var toast = document.getElementById("cx-toast");
				var timer;
				function show(message) {
					toast.textContent = message;
					toast.classList.remove("hidden");
					clearTimeout(timer);
					timer = setTimeout(function () {
						toast.classList.add("hidden");
					}, 4000);
				}
				// Spreadsheet paste into the Performance / Paid Ads grids: pasting 2+ cells
				// into a manual cell opens a preview (src/server/render/pastePreview.ts)
				// instead of dropping the raw text into that one input. A single value
				// still pastes into the input as normal.
				var preview = document.getElementById("cx-paste-preview");
				var pasteCellRect = null;
				function hidePreview() {
					preview.classList.add("hidden");
				}
				function placePreview() {
					if (!pasteCellRect) return;
					var width = preview.offsetWidth || 440;
					var height = preview.offsetHeight || 120;
					var left = Math.max(8, Math.min(pasteCellRect.left, window.innerWidth - width - 8));
					var top = pasteCellRect.bottom + 4;
					if (top + height > window.innerHeight - 8) top = Math.max(8, pasteCellRect.top - height - 4);
					preview.style.left = left + "px";
					preview.style.top = top + "px";
				}
				document.addEventListener("paste", function (event) {
					var cell = event.target && event.target.closest ? event.target.closest("td[data-paste-url]") : null;
					if (!cell) return;
					var text = (event.clipboardData && event.clipboardData.getData("text/plain")) || "";
					if (!/[\t\n]/.test(text.replace(/\r?\n$/, ""))) return;
					event.preventDefault();
					var section = cell.closest("section[data-month-count]");
					pasteCellRect = cell.getBoundingClientRect();
					if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
					preview.innerHTML = '<p class="text-[12px] text-muted">Reading pasted cells…</p>';
					preview.classList.remove("hidden");
					placePreview();
					htmx.ajax("POST", cell.dataset.pasteUrl, {
						target: preview,
						swap: "innerHTML",
						values: {
							text: text,
							metricId: cell.dataset.metricId,
							month: cell.dataset.month,
							months: section ? section.dataset.monthCount : "",
						},
					});
				});
				document.addEventListener("htmx:afterSwap", function (event) {
					if (event.detail.target === preview) placePreview();
				});
				document.addEventListener("keydown", function (event) {
					if (event.key === "Escape") hidePreview();
				});
				document.addEventListener("mousedown", function (event) {
					if (!preview.classList.contains("hidden") && !preview.contains(event.target)) hidePreview();
				});

				document.addEventListener("htmx:responseError", function () {
					show("Update failed — please try again.");
				});
				document.addEventListener("htmx:sendError", function () {
					show("Network error — check your connection and try again.");
				});
			})();
		</script>
	</body>
</html>
