---
export const prerender = false;

import Layout from "../layouts/Layout.astro";

Astro.response.status = 500;
---

<Layout title="Something went wrong">
	<main class="mx-auto max-w-6xl px-6 py-10">
		<a href="/" class="text-[13px] font-medium text-link hover:underline">&larr; All clients</a>

		<div class="mt-6 rounded-2xl border border-dashed border-card-border bg-surface p-10 text-center">
			<p class="text-[14px] font-medium text-ink">Something went wrong loading this page.</p>
			<p class="mt-1 text-[13px] text-muted">This is usually temporary — please try again in a moment.</p>
			<a
				href="/"
				class="mt-4 inline-block rounded-full bg-selected-filter px-4 py-1.5 text-[13px] font-medium text-surface hover:opacity-90"
			>
				Back to Overview
			</a>
		</div>
	</main>
</Layout>
