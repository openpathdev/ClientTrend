---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { env } from "cloudflare:workers";
import { createSupabaseClient } from "../server/supabase";
import { listStatuses } from "../server/data/statuses";
import { listCsms } from "../server/data/csms";
import { listStates } from "../server/data/states";
import { listClients } from "../server/data/clients";
import { renderOverviewPanel } from "../server/render/overviewPanel";
import { getLatestSyncRun, listSyncRunProblemClients } from "../server/data/hubspotSyncLog";
import { renderHubspotSyncStatus, isRunActive, HUBSPOT_SYNC_FINISHED_EVENT } from "../server/render/hubspotSyncStatus";
import type { ClientFilters } from "../server/data/types";

const url = new URL(Astro.request.url);
const filters: ClientFilters = {
	csmId: url.searchParams.get("csm") ?? undefined,
	statusId: url.searchParams.get("status") ?? undefined,
	stateCode: url.searchParams.get("state") ?? undefined,
};

const supabase = createSupabaseClient(env);
const [statuses, csms, states, clients, latestSync] = await Promise.all([
	listStatuses(supabase),
	listCsms(supabase),
	listStates(supabase),
	listClients(supabase, filters),
	getLatestSyncRun(supabase),
]);
// "Last synced …" (or live progress, if a sync is running right now) next to the Sync HubSpot button.
const syncProblems =
	latestSync && latestSync.clientsFailed > 0 && !isRunActive(latestSync, new Date()) ? await listSyncRunProblemClients(supabase, latestSync.id) : [];
const syncStatusHtml = (await renderHubspotSyncStatus({ run: latestSync, problemClients: syncProblems })).toString();

const panelHtml = (await renderOverviewPanel({ clients, statuses, csms, states, filters })).toString();
const accountCount = clients.length;
---

<Layout title="Overview">
	<main class="mx-auto max-w-7xl px-6 py-10">
		<header class="mb-6 flex items-start justify-between gap-4">
			<div>
				<h1 class="font-sans text-[26px] font-semibold tracking-[-0.02em] text-ink">Client Trends</h1>
				<p class="mt-1 font-mono text-[13px] text-muted">{accountCount} account{accountCount === 1 ? "" : "s"}</p>
			</div>
			<div class="flex shrink-0 items-center gap-3">
				<Fragment set:html={syncStatusHtml} />
				{/* When a sync this page is watching finishes, reload the card grid with whatever filters are in the URL now. */}
				<div
					hidden
					hx-get="/partials/clients"
					hx-vals="js:{...Object.fromEntries(new URLSearchParams(location.search))}"
					hx-trigger={`${HUBSPOT_SYNC_FINISHED_EVENT} from:body`}
					hx-target="#overview-panel"
					hx-swap="outerHTML"
				></div>
				<button
					type="button"
					hx-post="/api/admin/hubspot-sync/trigger"
					hx-target="#hubspot-sync-status"
					hx-swap="outerHTML"
					hx-indicator="#hubspot-sync-loading"
					class="relative flex items-center justify-center rounded-md border border-card-border bg-surface px-3 py-1.5 text-[13px] font-medium text-ink hover:bg-zebra-row"
				>
					<span
						id="hubspot-sync-loading"
						class="htmx-indicator absolute left-2.5 inline-block h-3.5 w-3.5 animate-spin rounded-full border-2 border-card-border border-t-ink"
						role="status"
						aria-label="Syncing"
					></span>
					Sync HubSpot
				</button>
				<a
					href="/admin/import"
					class="rounded-md bg-selected-filter px-3 py-1.5 text-[13px] font-medium text-white hover:opacity-90"
				>
					+ Add Client
				</a>
			</div>
		</header>

		<Fragment set:html={panelHtml} />
	</main>
</Layout>
